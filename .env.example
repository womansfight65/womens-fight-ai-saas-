# ---------------------------------------------------------------------------
# Woman's Fight AI — environment
# Copy to `.env.local` and fill in. Never commit real secrets.
# The app runs without any of these, in a clearly-labelled development mode.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Postgres, Auth, Storage, RLS) --------------------------------
# Project settings -> API. Without these the app uses a local development store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (the AI brain) --------------------------------------------------
# Without this the app uses a mock AI provider that labels every response.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Media providers (future phase) -----------------------------------------
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=

# --- Billing (future phase) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Social platforms (future phase) ----------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Scheduler worker -------------------------------------------------------
# Shared secret required by POST /api/scheduler/run so only your cron can call it.
SCHEDULER_WORKER_SECRET=
