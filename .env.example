# ---------------------------------------------------------------------------
# Woman's Fight AI — environment
# Copy to `.env.local` and fill in. Never commit real secrets.
# The app runs without any of these, in a clearly-labelled development mode.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Postgres, Auth, Storage, RLS) --------------------------------
# Project settings -> API. Without these the app uses a local development store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (the AI brain) ----------------------------------------------
# Without either of these the app uses a mock AI provider that labels every
# response. If both are set, Claude is used.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
# Alternative to Claude — from platform.openai.com -> API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Media providers (future phase) -----------------------------------------
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=

# --- Billing (future phase) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Social platforms --------------------------------------------------------
# Facebook: from developers.facebook.com -> My Apps -> your app -> Settings -> Basic.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram: a separate, dedicated Instagram app ("Instagram API with Instagram
# Login") from the Meta Dashboard -> its own App ID/Secret under Instagram ->
# API setup. The creator logs in with their own Instagram account directly —
# no Facebook Page required. Redirect URI to register there:
# <NEXT_PUBLIC_SITE_URL>/api/social/callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok: from developers.tiktok.com -> your app -> Basic information.
# Redirect URI to register there: <NEXT_PUBLIC_SITE_URL>/api/social/callback/tiktok
# Production app credentials — only used on a real Vercel Production deploy.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Sandbox app credentials — used everywhere else (preview deploys, local dev),
# so testing never touches the Production app's audited scopes or its Target
# User allowlist. Falls back to TIKTOK_CLIENT_KEY/SECRET above if left unset.
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
# The rest are future phase.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Scheduler worker -------------------------------------------------------
# Shared secret required by POST /api/scheduler/run so only your cron can call it.
SCHEDULER_WORKER_SECRET=
